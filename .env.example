# ── Core Flask ────────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=replace-with-output-of--python-c-import-secrets-print-secrets.token_hex-32

# ── Database (Railway injects this automatically) ─────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Redis for rate limiting (optional — Railway Redis add-on) ─────────────────
# If not set, rate limiting uses in-memory storage (resets on restart)
REDIS_URL=redis://default:password@host:6379

# ── First admin user (used only by: flask create-admin) ──────────────────────
SEED_ADMIN_EMAIL=you@yourdomain.com
SEED_ADMIN_PASSWORD=choose-a-strong-password
SEED_ADMIN_NAME=Your Name

# ── Legacy single-admin fallback (used only when DATABASE_URL is not set) ─────
ADMIN_EMAIL=admin@tryaiden.ai
ADMIN_PASSWORD_HASH=

# ── App URL ───────────────────────────────────────────────────────────────────
APP_BASE_URL=https://your-app.up.railway.app
COOKIE_DOMAIN=

# ── Discord bot ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# ── Telegram bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Amazon Relay automation ───────────────────────────────────────────────────
RELAY_PROFILE_PATH=.browser_profile/
RELAY_HEADLESS=true

# ── Google / Gmail ────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=

# ── Amazon Trip Report (daily 8 AM job) ───────────────────────────────────────
# Required for email delivery:
REPORT_RECIPIENT_EMAIL=you@yourdomain.com

# Optional overrides (defaults shown):
# REPORT_WINDOW_DAYS=7          # days of trip history to include
# REPORT_DRY_RUN=false          # true = generate PDFs but skip email + Discord
# REPORT_FORCE_RESEND=false     # true = ignore already-sent idempotency check
# REPORT_DRIVER_NAMES=          # comma-separated allow-list, e.g. "Chad Salerno,Roy Workman"
# REPORT_OUTPUT_DIR=/tmp/trip_reports  # where PDFs are written
# REPORT_DISCORD_WEBHOOK_URL=   # separate webhook for report notifications
#                               # (falls back to DISCORD_WEBHOOK_URL if unset)

# Amazon Relay credentials (used by relay_cron.py at 4 AM — report_cron reads DB output)
AMAZON_RELAY_EMAIL=
AMAZON_RELAY_PASSWORD=
